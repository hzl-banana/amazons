// Zobrist哈希表
static uint64_t g_zobrist_table[64][3];  // [位置][类型:0=空,1=黑棋,2=白棋]
static uint64_t g_zobrist_player_turn;   // 轮到哪一方

/**
 * 初始化Zobrist哈希表
 */
void initialize_zobrist() {
    static bool zobrist_initialized = false;
    if (zobrist_initialized) return;

    // 使用固定的随机种子以确保可重复性
    srand(0xABCD1234);

    // 初始化棋盘位置的随机数
    for (int position = 0; position < 64; position++) {
        for (int piece_type = 0; piece_type < 3; piece_type++) {
            g_zobrist_table[position][piece_type] = 0;
            for (int k = 0; k < 4; k++) {
                g_zobrist_table[position][piece_type] = (g_zobrist_table[position][piece_type] << 16) | (rand() & 0xFFFF);
            }
        }
    }

    // 初始化先手随机数
    g_zobrist_player_turn = 0;
    for (int k = 0; k < 4; k++) {
        g_zobrist_player_turn = (g_zobrist_player_turn << 16) | (rand() & 0xFFFF);
    }

    zobrist_initialized = true;
}

/**
 * 计算棋盘状态的哈希值
 * @param game_state 棋盘状态
 * @param player_turn 当前玩家
 * @return 哈希值
 */
uint64_t calculate_board_hash(GameState* game_state, int player_turn) {
    uint64_t hash_value = 0;

    // 处理黑棋
    uint64_t black_pieces = game_state->piece_position[PLAYER_BLACK];
    while (black_pieces) {
        int position = __builtin_ctzll(black_pieces);
        hash_value ^= g_zobrist_table[position][1];  // 黑棋
        black_pieces &= black_pieces - 1;
    }

    // 处理白棋
    uint64_t white_pieces = game_state->piece_position[PLAYER_WHITE];
    while (white_pieces) {
        int position = __builtin_ctzll(white_pieces);
        hash_value ^= g_zobrist_table[position][2];  // 白棋
        white_pieces &= white_pieces - 1;
    }

    // 处理箭（棋盘上有但既不是黑棋也不是白棋的位置）
    uint64_t arrow_positions = game_state->board_bitmap & ~(game_state->piece_position[PLAYER_BLACK] | game_state->piece_position[PLAYER_WHITE]);
    while (arrow_positions) {
        int position = __builtin_ctzll(arrow_positions);
        hash_value ^= g_zobrist_table[position][0];  // 箭
        arrow_positions &= arrow_positions - 1;
    }

    // 添加当前玩家信息
    if (player_turn == PLAYER_BLACK) {
        hash_value ^= g_zobrist_player_turn;
    }

    return hash_value;
}

/**
 * 更新哈希值（移动棋子）
 * @param current_hash 旧的哈希值
 * @param from_position 旧位置
 * @param to_position 新位置
 * @param arrow_position 箭的位置
 * @param piece_type 棋子类型 (1=黑棋, 2=白棋)
 * @param previous_turn 当前玩家
 * @param next_turn 下一个玩家
 * @return 新的哈希值
 */
uint64_t update_board_hash(uint64_t current_hash, int from_position, int to_position, int arrow_position,
    int piece_type, int previous_turn, int next_turn) {
    // 移除旧位置的棋子
    current_hash ^= g_zobrist_table[from_position][piece_type];

    // 添加新位置的棋子
    current_hash ^= g_zobrist_table[to_position][piece_type];

    // 添加箭
    current_hash ^= g_zobrist_table[arrow_position][0];

    // 切换玩家（移除旧玩家，添加新玩家）
    if (previous_turn != next_turn) {
        current_hash ^= g_zobrist_player_turn;
    }

    return current_hash;
}

