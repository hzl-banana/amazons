/**
 * 打印当前棋盘状态
 * @param game_state 状态节点
 */
void display_chessboard(GameState* game_state) {
    for (int position = 0; position < 64; position++) {
        // 每行开始前换行
        if (!(position & 0x7)) {
            fprintf(stderr, "\n");
        }

        if (game_state->board_bitmap & (1ull << position)) {
            // 有棋子的位置
            if (game_state->piece_position[g_current_player] & (1ull << position)) {
                fprintf(stderr, "A ");  // 己方棋子
            }
            else if (game_state->piece_position[1 - g_current_player] & (1ull << position)) {
                fprintf(stderr, "B ");  // 对方棋子
            }
            else {
                fprintf(stderr, "X ");  // 箭
            }
        }
        else {
            fprintf(stderr, "_ ");      // 空位
        }
    }
    fprintf(stderr, "\n");
}

/**
 * 简单打印棋盘位图
 * @param board_bitmap 棋盘位图
 */
void print_board_bitmap(uint64_t board_bitmap) {
    for (int position = 0; position < 64; position++) {
        if (!(position & 0x7)) {
            putchar('\n');
        }

        if (board_bitmap & (1ull << position)) {
            printf("X ");  // 有障碍
        }
        else {
            printf("_ ");  // 空位
        }
    }
    puts("");
}

