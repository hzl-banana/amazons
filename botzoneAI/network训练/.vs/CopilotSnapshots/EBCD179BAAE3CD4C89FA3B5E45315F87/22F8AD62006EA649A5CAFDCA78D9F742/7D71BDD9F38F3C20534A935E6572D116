/**
 * 查询开局库
 * @param board_hash 棋盘哈希值
 * @param book_entry 输出：找到的开局库条目
 * @return 是否找到匹配项
 */
bool lookup_opening_book(uint64_t board_hash, OpeningBookEntry** book_entry) {
    if (!g_opening_book_available) return false;

    // 在内置开局库中线性查找
    for (int i = 0; i < g_builtin_opening_book_size; i++) {
        if (builtin_opening_book[i].board_hash == board_hash && builtin_opening_book[i].recommended_move_count > 0) {
            *book_entry = &builtin_opening_book[i];
            return true;
        }
    }

    return false;
}

/**
 * 根据权重随机选择一个开局库走法
 * @param book_entry 开局库条目
 * @param from_x,from_y 输出：起始位置
 * @param to_x,to_y 输出：目标位置
 * @param arrow_x,arrow_y 输出：箭的位置
 * @return 是否成功选择走法
 */
bool choose_opening_move(OpeningBookEntry* book_entry, int* from_x, int* from_y,
    int* to_x, int* to_y, int* arrow_x, int* arrow_y) {
    if (book_entry->recommended_move_count == 0) return false;

    // 计算总权重
    uint32_t total_weight = 0;
    for (int i = 0; i < book_entry->recommended_move_count; i++) {
        total_weight += book_entry->recommended_moves[i].probability_score;
    }

    if (total_weight == 0) return false;

    // 随机选择一个走法（基于权重）
    uint32_t random_value = rand() % total_weight;
    uint32_t cumulative_weight = 0;

    for (int i = 0; i < book_entry->recommended_move_count; i++) {
        cumulative_weight += book_entry->recommended_moves[i].probability_score;
        if (random_value < cumulative_weight) {
            *from_x = book_entry->recommended_moves[i].from_x;
            *from_y = book_entry->recommended_moves[i].from_y;
            *to_x = book_entry->recommended_moves[i].to_x;
            *to_y = book_entry->recommended_moves[i].to_y;
            *arrow_x = book_entry->recommended_moves[i].arrow_x;
            *arrow_y = book_entry->recommended_moves[i].arrow_y;
            return true;
        }
    }

    // 如果上面没有选择到（理论上不会发生），选择第一个
    *from_x = book_entry->recommended_moves[0].from_x;
    *from_y = book_entry->recommended_moves[0].from_y;
    *to_x = book_entry->recommended_moves[0].to_x;
    *to_y = book_entry->recommended_moves[0].to_y;
    *arrow_x = book_entry->recommended_moves[0].arrow_x;
    *arrow_y = book_entry->recommended_moves[0].arrow_y;
    return true;
}

